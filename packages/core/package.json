{
  "name": "@r8s/core",
  "version": "0.2.1",
  "description": "JSX factory and renderer for r8s",
  "license": "MIT",
  "author": "Berget AI AB",
  "homepage": "https://r8s.berget.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berget-ai/r8s.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/berget-ai/r8s/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js",
      "require": "./dist/defaults.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails.d.ts",
      "import": "./dist/guardrails.js",
      "require": "./dist/guardrails.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@r8s/k8s-types": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
