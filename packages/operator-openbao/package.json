{
  "name": "@r8s/operator-openbao",
  "version": "2.6.2",
  "description": "OpenBao secrets server \u2014 natively rendered (helm-free) r8s operator package",
  "license": "MIT",
  "author": "Berget AI AB",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
