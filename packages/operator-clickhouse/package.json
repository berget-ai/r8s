{
  "name": "@r8s/operator-clickhouse",
  "version": "0.25.0",
  "description": "ClickHouse Operator for Kubernetes by Altinity \u2014 npm-resolved operator package for r8s",
  "license": "MIT",
  "author": "Berget AI AB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berget-ai/r8s.git",
    "directory": "packages/operator-clickhouse"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "r8s",
    "operator",
    "clickhouse",
    "clickhouse-operator"
  ],
  "r8s": {
    "category": "Operators",
    "operator": "clickhouse-operator"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@r8s/core": "^0.2.0",
    "@r8s/k8s-types": "^0.2.0",
    "@r8s/crds": "^0.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
