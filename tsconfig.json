{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "@r8s/core",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@r8s/core": ["./packages/core/src/index.ts"],
      "@r8s/core/defaults": ["./packages/core/src/defaults.ts"],
      "@r8s/core/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@r8s/core/jsx-dev-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@r8s/k8s-types": ["./packages/k8s-types/src/index.ts"],
      "@r8s/recipes": ["./packages/recipes/src/index.ts"],
      "@r8s/crds": ["./packages/crds/src/index.ts"],
      "@r8s/crds/*": ["./packages/crds/src/generated/*"],
      "@r8s/r8s-controller": ["./packages/r8s-controller/src/controller.ts"],
      "@r8s/example": ["./packages/example/src/index.ts"],
      "@r8s/element": ["./packages/element/src/index.ts"],
      "@r8s/grafana": ["./packages/grafana/src/index.ts"],
      "@r8s/rustfs": ["./packages/rustfs/src/index.ts"],
      "@r8s/superset": ["./packages/superset/src/index.ts"],
      "@r8s/wireguard": ["./packages/wireguard/src/index.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/k8s-types" },
    { "path": "./packages/core" },
    { "path": "./packages/crds" },
    { "path": "./packages/recipes" },
    { "path": "./packages/r8s-controller" },
    { "path": "./packages/cli" },
    { "path": "./packages/example" },
    { "path": "./packages/element" },
    { "path": "./packages/grafana" },
    { "path": "./packages/rustfs" },
    { "path": "./packages/superset" },
    { "path": "./packages/wireguard" }
  ]
}
